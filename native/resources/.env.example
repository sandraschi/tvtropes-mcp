# Backend bind (web + MCP HTTP)
TVTROPES_MCP_HOST=127.0.0.1
TVTROPES_MCP_PORT=10964

# Data storage (SQLite DB + scraper cache)
TVTROPES_MCP_DATA_DIR=

# Ollama extraction endpoint
TVTROPES_MCP_OLLAMA_HOST=http://localhost:11434
TVTROPES_MCP_OLLAMA_MODEL=qwen2.5:27b
TVTROPES_MCP_OLLAMA_TIMEOUT=120.0

# Scraper politeness
TVTROPES_MCP_SCRAPER_DELAY_MIN=8.0
TVTROPES_MCP_SCRAPER_DELAY_MAX=15.0
TVTROPES_MCP_SCRAPER_DAILY_BUDGET=7000
