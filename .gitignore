# tvtropes-mcp — gitignore

# Scraped data — never commit
data/
scraper/cache/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
.uv/

# Node (dashboard)
web_sota/node_modules/
web_sota/dist/

# Env
.env
*.env.local
_dashboard/

# Reports (regenerable snapshots)
reports/

# MCPB pack staging (rebuilt on every pack; never commit)
mcpb/src/

# Runtime logs (services write here - untracked)
*.log
logs/
